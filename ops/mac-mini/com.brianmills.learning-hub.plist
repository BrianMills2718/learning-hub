<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brianmills.learning-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/b/Sites/learning-environment-pilot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LEARNING_HUB_HOST</key>
    <string>127.0.0.1</string>
    <key>LEARNING_HUB_PORT</key>
    <string>8780</string>
    <key>LEARNING_HUB_DATA_ROOT</key>
    <string>/Users/b/Library/Application Support/learning-hub</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/b/Library/Logs/learning-hub.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/b/Library/Logs/learning-hub-error.log</string>
</dict>
</plist>
