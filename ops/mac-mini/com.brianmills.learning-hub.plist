<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.brianmills.learning-hub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-m</string>
    <string>http.server</string>
    <string>8780</string>
    <string>--bind</string>
    <string>127.0.0.1</string>
    <string>--directory</string>
    <string>/Users/b/Sites/learning-environment-pilot</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/b/Sites/learning-environment-pilot</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/b/Library/Logs/learning-hub.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/b/Library/Logs/learning-hub-error.log</string>
</dict>
</plist>
